{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/router?path=$1" },
    { "source": "/go/(.*)", "destination": "/api/router?path=go&slug=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
